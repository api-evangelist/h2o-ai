                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Updates the logo for an admin-defined predefined MCP by uploading a new logo file. This endpoint is restricted to admin users only.\n"
        },
        {
          "info": {
            "name": "Remove admin MCP logo (Admin only)",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/agents/builtin_mcps/admin/:mcp_id/logo",
            "params": [
              {
                "name": "mcp_id",
                "value": "",
                "type": "path",
                "description": "The MCP identifier"
