          "http": {
            "method": "GET",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/agents/builtin_mcps"
          },
          "docs": "Returns the list of built-in predefined MCPs (Model Context Protocol servers) available for use. Includes information about which MCPs are already added as tools and which OAuth apps are connected.\n"
        },
