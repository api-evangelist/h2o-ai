        {
          "info": {
            "name": "Unified MCP tool inspection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/agents/mcp/inspect_tool",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Unified endpoint for inspecting MCP tools. Supports three modes: (1) tool_id — inspect an existing local or remote MCP tool by database ID, (2) servers — inspect one or more remote MCP server configs (pre-add), (3) file_name + file_data_base64 — inspect an uploaded package (pre-add). Returns a list of per-server inspection results.\n"
        },
        {
          "info": {
            "name": "List tools from MCP servers",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/agents/mcp/list_tools",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Lists tools from configured MCP servers, optionally filtered by config type and server names.\n"
        },
        {
          "info": {
            "name": "Get Claude SDK options schema",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/agents/mcp/sdk_options"
          },
          "docs": "Returns the schema of available Claude SDK options that can be configured for MCP tool runners. Includes permission modes, effort levels, available betas, hook actions, and limitations.\n"
        },
        {
          "info": {
            "name": "Lists built-in MCPs",
            "type": "http"
