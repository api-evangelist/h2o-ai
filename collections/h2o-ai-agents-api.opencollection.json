{
  "opencollection": "1.0.0",
  "info": {
    "name": "h2oGPTe REST Agents API",
    "version": "v1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
