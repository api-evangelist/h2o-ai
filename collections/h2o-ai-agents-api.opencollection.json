          "info": {
            "name": "Add a built-in MCP",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/agents/builtin_mcps/add",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "mcp_id",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "keys",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "files",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Adds a built-in MCP (Model Context Protocol server) to the user's tools. This endpoint configures and enables a predefined MCP for the user with direct file uploads.\n"
        },
