          "http": {
            "method": "GET",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/agents/directory_stats",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "How many agent chat sessions to skip before returning."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "How many agent chat sessions to return."
              },
              {
                "name": "filter_text",
                "value": "",
                "type": "query",
                "description": "Applied text filter."
              }
            ]
          },
          "docs": "Lists agent directory stats across all agent chat sessions."
        },
