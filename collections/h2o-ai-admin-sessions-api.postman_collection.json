        {
          "id": "5fb0727f-e67e-4997-a09d-b79bfbd56ebc",
          "name": "Revoke a session",
          "request": {
            "name": "Revoke a session",
            "description": {
              "content": "Force-revokes a live session by ID. Reuses the same revoke path as user-driven sign-out, so peer mux replicas drop their cached copy via pub/sub. DELETE is idempotent — returns 204 whether the session existed or not.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "admin",
                "sessions",
                ":session_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "session_id",
                  "description": "(Required) ID of the session to revoke."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "DELETE",
            "auth": null
          },
