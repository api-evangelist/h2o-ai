        {
          "info": {
            "name": "Pause an AI assistant.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/ai_assistants/:assistant_id/pause",
            "params": [
              {
                "name": "assistant_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Pauses the assistant. Events accumulate in the queue and will be processed when unpaused."
        },
        {
          "info": {
            "name": "Unpause an AI assistant.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/ai_assistants/:assistant_id/unpause",
            "params": [
              {
                "name": "assistant_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Resumes the assistant from paused state. Accumulated events will be processed on the next event loop tick."
        },
        {
          "info": {
            "name": "Start an AI assistant.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/ai_assistants/:assistant_id/start",
