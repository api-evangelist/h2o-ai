        {
          "info": {
            "name": "List AI assistants.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/ai_assistants",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "How many assistants to skip."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "How many assistants to return."
              },
              {
                "name": "name_filter",
                "value": "",
                "type": "query",
                "description": "Filter assistants by name."
              },
              {
                "name": "status_filter",
                "value": "",
                "type": "query",
                "description": "Filter assistants by status."
              }
            ]
          },
          "docs": "List AI assistants accessible to the current user."
        },
        {
          "info": {
            "name": "Create an AI assistant.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/ai_assistants",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new persistent AI assistant with wake/sleep lifecycle."
        },
        {
          "info": {
            "name": "Generate AI assistant spec from a prompt.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/ai_assistants/generate_spec",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Uses an LLM with guided JSON to generate one or more AI assistant configurations\nfrom a natural language description. The returned specs map to every field in the\ncreate-assistant UI and can be used directly with the create_ai_assistant endpoint.\n"
        },
