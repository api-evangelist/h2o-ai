                "type": "path"
              }
            ]
          },
          "docs": "Start an AI assistant."
        },
        {
          "info": {
            "name": "Stop an AI assistant and cancel any running agent.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/ai_assistants/:assistant_id/stop",
            "params": [
              {
                "name": "assistant_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Transitions the assistant to the stopped state. If the assistant is currently\nrunning an agent, the running agent is also cancelled by setting the Redis stop\nflag on the active chat question, which triggers a .terminate file push to the\nagent container. The wake queue is drained and pending approvals are cancelled.\n"
        },
