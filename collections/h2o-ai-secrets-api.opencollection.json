{
  "opencollection": "1.0.0",
  "info": {
    "name": "h2oGPTe REST Secrets API",
    "version": "v1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Secrets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Lists available secret IDs from SecureStore.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/secrets/ids",
            "params": [
              {
                "name": "connector_type",
                "value": "",
                "type": "query",
                "description": "Type of connector (s3, gcs, azure_key, azure_sas)"
              }
            ]
          },
          "docs": "Lists available secret IDs from SecureStore for a specific connector type."
        },
        {
          "info": {
            "name": "Get a secret by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/secrets/:secret_id",
            "params": [
              {
                "name": "secret_id",
                "value": "",
                "type": "path",
                "description": "The ID of the secret to retrieve"
              }
            ]
          },
          "docs": "Retrieves a secret from SecureStore by its ID."
        },
        {
          "info": {
            "name": "Update a secret",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/secrets/:secret_id",
            "params": [
              {
                "name": "secret_id",
                "value": "",
                "type": "path",
                "description": "The ID of the secret to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing secret in SecureStore."
        },
        {
          "info": {
            "name": "Delete a secret",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/secrets/:secret_id",
            "params": [
              {
                "name": "secret_id",
                "value": "",
                "type": "path",
                "description": "The ID of the secret to delete"
              }
            ]
          },
          "docs": "Deletes a secret from SecureStore by its ID."
        },
        {
          "info": {
            "name": "Get the value of a secret by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/secrets/:secret_id/value",
            "params": [
              {
                "name": "secret_id",
                "value": "",
                "type": "path",
                "description": "The ID of the secret to retrieve the value for"
              }
            ]
          },
          "docs": "Retrieves the actual value/credentials of a secret from SecureStore by its ID."
        },
        {
          "info": {
            "name": "Create a new secret",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://h2ogpte.genai.h2o.ai/api/v1/secrets",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new secret in SecureStore."
        }
      ]
    }
  ],
  "bundled": true
}