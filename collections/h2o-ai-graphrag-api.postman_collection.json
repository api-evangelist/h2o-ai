        {
          "id": "0a4fbd5a-2cb3-4902-b533-0663ae322dbe",
          "name": "Delete the knowledge graph for a collection.",
          "request": {
            "name": "Delete the knowledge graph for a collection.",
            "description": {
              "content": "Tears down the collection's knowledge graph: removes the stored\ntarball from object storage, drops the in-memory per-collection\nlock and event loop, removes the local LightRAG cache directory,\nand resets graph_status to 'none'. The collection itself is\nunaffected. Auto-RAG selection will revert to normal RAG until\na new graph is built.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "graph",
                ":collection_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "collection_id",
                  "description": "(Required) The collection whose graph should be deleted."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "DELETE",
            "auth": null
          },
          "response": [
            {
              "id": "a83937e2-50d9-4a7a-8d5c-b438d3cd5685",
              "name": "Graph deleted successfully.",
              "originalRequest": {
                "url": {
                  "path": [
                    "graph",
                    ":collection_id"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
